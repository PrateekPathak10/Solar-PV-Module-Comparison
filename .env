# Required for live web research. Keep actual secrets in .env and never commit it.
EXA_API_KEY=your_exa_api_key_here

# Optional Groq model for prompt interpretation and evidence extraction.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional enrichment. Leave unset until MoltSets endpoint/auth/request schema are verified.
MOLTSETS_API_KEY=
MOLTSETS_BASE_URL=
MOLTSETS_SEARCH_COMPANIES_PATH=

# Network timeout and bounded search size.
REQUEST_TIMEOUT_SECONDS=25
MAX_SEARCH_RESULTS=8
